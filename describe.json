    {
      "name": "bookfish_lookup",
      "description": "Saved records. If you already hold an episode id, read it directly with action=\"context\" and episodeIds — no search needed. Use action=\"search\" only when you have keywords but no id. Zero search hits do not prove nothing was recorded.",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "search",
              "context",
              "episode",
              "journal",
              "recall",
              "story"
            ]
          },
          "bookKey": {
            "type": "string",
            "description": "Exact book revision key."
          },
          "storyAction": {
            "type": "string",
            "enum": [
              "overview",
              "evidence",
              "entity"
            ]
          },
          "eventIds": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "string"
            }
          },
          "atFrontier": {
            "type": "integer",
            "minimum": 0
          },
          "query": {
            "type": "string",
            "maxLength": 160,
            "description": "Short keywords, at most eight."
          },
          "character": {
            "type": "string",
            "maxLength": 160
          },
          "chapter": {
            "type": "string",
            "maxLength": 160
          },
          "segmentId": {
            "type": "integer",
            "minimum": 0
          },
          "segmentIds": {
            "type": "array",
            "maxItems": 4,
            "items": {
              "type": "integer",
              "minimum": 0
            }
          },
          "episodeId": {
            "type": "string"
          },
          "episodeIds": {
            "type": "array",
            "maxItems": 4,
            "items": {
              "type": "string"
            }
          },
          "taskIds": {
            "type": "array",
            "maxItems": 4,
            "items": {
              "type": "string"
            }
          },
          "kind": {
            "type": "string",
            "enum": [
              "all",
              "episode",
              "receipt",
              "text"
            ]
          },
          "before": {
            "type": "integer",
            "minimum": 1
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          },
          "cursor": {
            "type": "string",
            "maxLength": 500
          },
          "includeRelated": {
            "type": "boolean"
          },
          "maxChars": {
            "type": "integer",
            "minimum": 2000,
            "maximum": 16000
          }
        },
        "required": [
          "action"
        ]
      },
      "tags": [
        "read"
      ],
      "summary": {
        "zh": "回查已读原文、手账、感想与修订；不改变进度，不返回未读正文。",
        "en": "Looks up confirmed text, journal, episodes and revisions without advancing progress or returning unread text."
      }
