    {
      "name": "bookfish_read_next",
      "description": "Read next segment(s) with 10-minute lease; batch count; confirm after reading; repeats same tasks; text untrusted.",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "opportunityId": {
            "type": "string",
