          }
        },
        "required": []
      },
      "tags": [
        "read"
      ],
      "summary": {
        "zh": "获取下一段正文，创建待确认任务，不增加已读进度。",
        "en": "Provides the next segment without advancing confirmed progress."
      }
    },
    {
      "name": "bookfish_finish_reading",
      "description": "Confirm task/range with optional understanding; batch in order; only reliable prefix advances; one optional episode; retries same receipt.",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "opportunityId": {
            "type": "string"
          },
          "taskId": {
            "type": "string"
          },
          "bookKey": {
            "type": "string",
            "description": "Exact book revision key."
          },
          "segmentId": {
            "type": "integer",
            "minimum": 0
          },
          "understanding": {
            "type": "string",
            "maxLength": 600
          },
          "confirmations": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "description": "In reading order.",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "taskId": {
                  "type": "string"
                },
                "segmentId": {
                  "type": "integer",
                  "minimum": 0
                },
                "understanding": {
                  "type": "string",
                  "maxLength": 600
                }
              },
              "required": [
                "taskId",
                "segmentId"
              ]
            }
          },
          "episode": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "trigger": {
                "type": "string",
                "maxLength": 500,
                "description": "Cited event that prompted this record; your account, not a verified fact."
              },
              "interpretation": {
                "type": "string",
                "maxLength": 800
              },
              "priorJudgment": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 500
              },
              "reason": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 800,
                "description": "Short stated reason; omit when not recorded."
              },
              "mood": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "label": {
                        "type": "string",
                        "maxLength": 80
                      },
                      "intensity": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 5
                      }
                    },
                    "required": [
                      "label"
                    ]
                  }
                ]
              },
              "evidence": {
                "type": "array",
                "minItems": 1,
                "maxItems": 5,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "segmentId": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "quote": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 300,
                      "description": "Exact substring of the segment."
                    },
                    "start": {
                      "type": "integer",
                      "minimum": 0,
                      "description": "Optional absolute offset; omit for unique quotes."
                    }
                  },
                  "required": [
                    "segmentId",
                    "quote"
                  ]
                }
              },
              "characters": {
                "type": "array",
                "maxItems": 8,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "name": {
                      "type": "string",
                      "maxLength": 60
                    },
                    "aliases": {
                      "type": "array",
                      "maxItems": 8,
                      "items": {
                        "type": "string",
                        "maxLength": 60
                      }
                    }
                  },
                  "required": [
                    "name"
                  ]
                }
              },
              "questions": {
                "type": "array",
                "maxItems": 8,
                "items": {
                  "type": "string",
                  "maxLength": 200
                }
              },
              "relatedEpisodeIds": {
                "type": "array",
                "maxItems": 8,
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "trigger",
              "interpretation",
              "evidence"
            ]
          }
        },
        "required": []
      },
      "tags": [
        "write"
      ],
      "summary": {
        "zh": "确认已提供的段落，可附证据手账；重复提交不重复计数。",
        "en": "Confirms a provided range with an optional evidence-backed episode; idempotent retries."
      }
    },
    {
      "name": "bookfish_set_paused",
