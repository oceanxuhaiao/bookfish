+++ b/tests/import-batch-budget.test.ts
@@ -0,0 +1,202 @@
+import { afterEach, beforeEach, describe, expect, it } from 'vitest';
+import { createWriteStream, existsSync, mkdirSync, mkdtempSync, readdirSync, readFileSync, rmSync, statSync, writeFileSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { Library } from '../src/library.ts';
+import { DEFAULT_BATCH_BUDGET, ImportBatches } from '../src/import-batches.ts';
+import { BATCH_CONCURRENCY, BATCH_ITEM_LIMIT, BATCH_STAGING_BYTES, MAX_BATCH_FILE_BYTES, ZIP_MAX_BYTES, batchStagingName } from '../src/import-batch.ts';
+
+const MiB = 1024 * 1024;
+let dir: string, lib: Library, batches: ImportBatches, time: number;
+const now = () => time;
+
+beforeEach(() => {
+  dir = mkdtempSync(join(tmpdir(), 'bookfish-batch-budget-'));
+  time = Date.parse('2026-10-06T08:00:00Z');
+  lib = new Library({ dataDir: dir, now });
+  lib.open();
+  batches = new ImportBatches(lib, join(dir, 'transfers'), { now });
+});
+afterEach(async () => {
+  await batches.shutdown();
+  try { lib.close(); } catch { /* already closed */ }
+  rmSync(dir, { recursive: true, force: true });
+});
+
+const names = (count: number) => Array.from({ length: count }, (_, index) => ({ name: `n${index}.txt`, size: 1024 }));
+
+describe('the declared limits are the ones that ship', () => {
+  it('pins every ceiling the task book names', () => {
+    expect(MAX_BATCH_FILE_BYTES).toBe(100 * MiB);
+    expect(BATCH_ITEM_LIMIT).toBe(100);
+    expect(BATCH_STAGING_BYTES).toBe(1024 * MiB);
+    expect(BATCH_CONCURRENCY).toBe(2);
+    expect(ZIP_MAX_BYTES).toBe(512 * MiB);
+    expect(DEFAULT_BATCH_BUDGET).toEqual({ batchBytes: 1024 * MiB, fileBytes: 100 * MiB, zipBytes: 512 * MiB });
+  });
+});
+
+describe('a batch can never stage more than its budget', () => {
+  it('accepts 100 files and reports the 101st as overflow without staging it', () => {
+    const batch = batches.create({ source: 'files' });
+    const result = batches.addItems(batch.id, names(101));
+    expect(result.added).toHaveLength(100);
+    expect(result.overflow).toBe(1);
+    expect(lib.importBatches()[0].items).toHaveLength(100);
+    // Nothing was written for the rejected file.
+    const staged = readdirSync(join(dir, 'transfers', 'batches', batch.id)).filter((file) => file.endsWith('.src'));
+    expect(staged).toHaveLength(0);
+  });
+
+  it('refuses a single file above 100 MiB before it is staged', () => {
+    const batch = batches.create({ source: 'files' });
+    const result = batches.addItems(batch.id, [{ name: 'huge.txt', size: 100 * MiB + 1 }]);
+    expect(result.added).toEqual([]);
+    expect(result.tooLarge).toEqual(['huge.txt']);
+    expect(lib.importBatches()[0].items).toEqual([]);
+  });
+
+  it('accepts exactly 100 MiB and exactly 1 GiB in total, refusing one byte more', () => {
+    // A per-file ceiling and a batch ceiling are different limits.
+    const single = batches.create({ source: 'files' });
+    const atCeiling = batches.addItems(single.id, [{ name: 'a.txt', size: MAX_BATCH_FILE_BYTES }]);
+    expect(atCeiling.added.map((item) => item.name)).toEqual(['a.txt']);
+
+    // Exactly 1 GiB built from files that each respect the 100 MiB ceiling.
+    const exact = batches.create({ source: 'files' });
+    const ten = Array.from({ length: 10 }, (_, index) => ({ name: `p${index}.txt`, size: MAX_BATCH_FILE_BYTES }));
+    const boundary = batches.addItems(exact.id, [...ten, { name: 'tail.txt', size: BATCH_STAGING_BYTES - 10 * MAX_BATCH_FILE_BYTES }]);
+    expect(boundary.added).toHaveLength(11);
+    expect(BATCH_STAGING_BYTES - 10 * MAX_BATCH_FILE_BYTES).toBe(24 * MiB);
+    const oneMore = batches.addItems(exact.id, [{ name: 'z.txt', size: 1 }]);
+    expect(oneMore.added).toEqual([]);
+    expect(oneMore.overBudget).toEqual(['z.txt']);
+  });
+
+  it('re-checks the budget when a chunk arrives, not only in the panel', () => {
+    const small = new ImportBatches(lib, join(dir, 'transfers'), { now, budget: { batchBytes: 4096 } });
+    const batch = small.create({ source: 'files' });
+    small.addItems(batch.id, [{ name: 'a.txt', size: 2048 }]);
+    // Tamper with the persisted batch the way a corrupted snapshot would.
+    lib.updateImportBatch(batch.id, (draft) => { draft.items[0].size = 1_000_000; });
+    expect(() => small.stage(batch.id, lib.importBatches()[0].items[0].id, 0, Buffer.from('hello').toString('base64')))
+      .toThrow('disk budget');
+    void small.shutdown();
+  });
+
+  it('refuses a chunked upload that would exceed the per-file ceiling', () => {
+    const batch = batches.create({ source: 'files' });
+    batches.addItems(batch.id, [{ name: 'a.txt', size: 64 }]);
+    const item = lib.importBatches()[0].items[0];
+    lib.updateImportBatch(batch.id, (draft) => { draft.items[0].size = 100 * MiB + 1; });
+    expect(() => batches.stage(batch.id, item.id, 0, Buffer.from('hello').toString('base64'))).toThrow('100 MiB');
+  });
+
+  it('rejects an archive that expands beyond the batch budget', async () => {
+    const yazl = await import('yazl');
+    const small = new ImportBatches(lib, join(dir, 'transfers'), { now, budget: { batchBytes: 4096, fileBytes: 3000 } });
+    const zipPath = join(dir, 'big.zip');
+    const zip = new yazl.ZipFile();
+    zip.addBuffer(Buffer.alloc(2048, 97), 'a.txt');
+    zip.addBuffer(Buffer.alloc(2048, 98), 'b.txt');
+    zip.addBuffer(Buffer.alloc(2048, 99), 'c.txt');
+    zip.end();
+    await new Promise<void>((resolve, reject) => {
+      const out = createWriteStream(zipPath);
+      out.on('close', () => resolve()).on('error', reject);
+      zip.outputStream.pipe(out);
+    });
+    const batch = small.create({ source: 'zip' });
+    small.zipBegin(batch.id, { name: 'big.zip', size: statSync(zipPath).size });
+    const bytes = readFileSync(zipPath);
+    for (let offset = 0; offset < bytes.length; offset += 64 * 1024) {
+      small.zipChunk(batch.id, offset, bytes.subarray(offset, offset + 64 * 1024).toString('base64'));
+    }
+    await expect(small.zipFinish(batch.id)).rejects.toThrow(/限制|GiB|过大|数量/u);
+    await small.shutdown();
+  });
+
+  it('rejects an archive entry above the per-book ceiling', async () => {
+    const yazl = await import('yazl');
+    const small = new ImportBatches(lib, join(dir, 'transfers'), { now, budget: { batchBytes: 1024 * 1024, fileBytes: 1024 } });
+    const zipPath = join(dir, 'entry.zip');
+    const zip = new yazl.ZipFile();
+    zip.addBuffer(Buffer.alloc(4096, 97), 'big.txt');
+    zip.end();
+    await new Promise<void>((resolve, reject) => {
+      const out = createWriteStream(zipPath);
+      out.on('close', () => resolve()).on('error', reject);
+      zip.outputStream.pipe(out);
+    });
+    const batch = small.create({ source: 'zip' });
+    small.zipBegin(batch.id, { name: 'entry.zip', size: statSync(zipPath).size });
+    const bytes = readFileSync(zipPath);
+    small.zipChunk(batch.id, 0, bytes.toString('base64'));
+    await expect(small.zipFinish(batch.id)).rejects.toThrow();
+    await small.shutdown();
+  });
+
+  it('refuses a ZIP upload body above 512 MiB', () => {
+    const batch = batches.create({ source: 'zip' });
+    expect(() => batches.zipBegin(batch.id, { name: 'huge.zip', size: ZIP_MAX_BYTES + 1 })).toThrow('512 MiB');
+  });
+
+  it('leaves other batches and already imported books untouched when one batch fails', async () => {
+    const goodBytes = Buffer.from('# good\n\n' + 'the sea is wide. '.repeat(8));
+    const good = batches.create({ source: 'files' });
+    batches.addItems(good.id, [{ name: 'good.txt', size: goodBytes.length }]);
+    const goodItem = lib.importBatches()[0].items[0];
+    batches.stage(good.id, goodItem.id, 0, goodBytes.toString('base64'));
+
+    const badBytes = Buffer.from('\u0000\u0001binary'.padEnd(64, 'x'));
+    const bad = batches.create({ source: 'files' });
+    batches.addItems(bad.id, [{ name: 'bad.txt', size: badBytes.length }]);
+    const badItem = lib.importBatches().at(-1)!.items[0];
+    batches.stage(bad.id, badItem.id, 0, badBytes.toString('base64'));
+
+    batches.start(good.id);
+    batches.start(bad.id);
+    await new Promise<void>((resolve, reject) => {
+      const started = Date.now();
+      const poll = setInterval(() => {
+        const rows = lib.importBatches();
+        const done = rows.every((row) => row.status === 'completed' || row.status === 'cancelled');
+        if (done) { clearInterval(poll); resolve(); return; }
+        if (Date.now() - started > 30_000) { clearInterval(poll); reject(new Error('timeout')); }
+      }, 60);
+    });
+    expect(lib.importBatches().find((row) => row.id === good.id)!.items[0].status).toBe('completed');
+    expect(lib.importBatches().find((row) => row.id === bad.id)!.items[0].status).toBe('failed');
+    expect(lib.list()).toHaveLength(1);
+
+    // Forgetting the failed batch removes only its own staging directory.
+    lib.forgetImportBatch(bad.id);
+    batches.cleanStale();
+    expect(existsSync(join(dir, 'transfers', 'batches', bad.id))).toBe(false);
+    expect(existsSync(join(dir, 'transfers', 'batches', good.id))).toBe(true);
+    expect(lib.list()).toHaveLength(1);
+  });
+
+  it('never deletes a directory it did not create', () => {
+    const batch = batches.create({ source: 'files' });
+    const foreign = join(dir, 'transfers', 'batches', 'someone-elses-data');
+    mkdirSync(foreign, { recursive: true });
+    writeFileSync(join(foreign, 'keep.txt'), 'keep');
+    batches.cleanStale();
+    expect(readFileSync(join(foreign, 'keep.txt'), 'utf8')).toBe('keep');
+    void batch;
+  });
+
+  it('keeps a batch item that is legitimate alongside one that is refused', () => {
+    const batch = batches.create({ source: 'files' });
+    const result = batches.addItems(batch.id, [
+      { name: 'ok.txt', size: 1024 },
+      { name: 'too-big.txt', size: MAX_BATCH_FILE_BYTES + 1 },
+      { name: 'other.txt', size: 1024 },
+    ]);
+    expect(result.added.map((item) => item.name)).toEqual(['ok.txt', 'other.txt']);
+    expect(result.tooLarge).toEqual(['too-big.txt']);
+    const staged = join(dir, 'transfers', 'batches', batch.id);
+    expect(readdirSync(staged).filter((file) => file === batchStagingName(result.added[0].id))).toEqual([]);
+  });
+});
diff --git a/tests/import-batch-chunks.test.ts b/tests/import-batch-chunks.test.ts
new file mode 100644
index 0000000..e44e495
--- /dev/null
+++ b/tests/import-batch-chunks.test.ts
@@ -0,0 +1,143 @@
+import { afterEach, beforeEach, describe, expect, it } from 'vitest';
+import { mkdtempSync, statSync, rmSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { Library } from '../src/library.ts';
+import { ImportBatches } from '../src/import-batches.ts';
+import { batchStagingName } from '../src/import-batch.ts';
+
+let dir: string, lib: Library, batches: ImportBatches, time: number;
+const now = () => time;
+
+beforeEach(() => {
+  dir = mkdtempSync(join(tmpdir(), 'bookfish-batch-chunks-'));
+  time = Date.parse('2026-10-08T08:00:00Z');
+  lib = new Library({ dataDir: dir, now });
+  lib.open();
+  batches = new ImportBatches(lib, join(dir, 'transfers'), { now });
+});
+afterEach(async () => {
+  await batches.shutdown();
+  try { lib.close(); } catch { /* already closed */ }
+  rmSync(dir, { recursive: true, force: true });
+});
+
+/** A book made of three identifiable parts so a wrong order is observable. */
+const PARTS = [Buffer.from('AAA-part-one\n'), Buffer.from('BBB-part-two\n'), Buffer.from('CCC-part-three\n')];
+const WHOLE = Buffer.concat(PARTS);
+
+function staged(name = 'book.txt', size = WHOLE.length) {
+  const batch = batches.create({ source: 'files' });
+  batches.addItems(batch.id, [{ name, size }]);
+  const item = lib.importBatches().at(-1)!.items[0];
+  return { batchId: batch.id, itemId: item.id, path: join(dir, 'transfers', 'batches', batch.id, batchStagingName(item.id)) };
+}
+
+const chunk = (buffer: Buffer) => buffer.toString('base64');
+
+describe('chunked upload is append-only and refuses to be talked out of it', () => {
+  it('assembles a file from an ordered run of chunks', () => {
+    const { batchId, itemId, path } = staged();
+    let offset = 0;
+    for (const part of PARTS) {
+      const ack = batches.stage(batchId, itemId, offset, chunk(part));
+      expect(ack.offset).toBe(offset + part.length);
+      offset = ack.offset;
+    }
+    expect(statSync(path).size).toBe(WHOLE.length);
+    expect(batches.stage(batchId, itemId, 0, chunk(PARTS[0]))).toMatchObject({ replayed: true });
+  });
+
+  it('refuses a skipped chunk instead of leaving a hole', () => {
+    const { batchId, itemId, path } = staged();
+    batches.stage(batchId, itemId, 0, chunk(PARTS[0]));
+    expect(() => batches.stage(batchId, itemId, PARTS[0].length + 5, chunk(PARTS[2]))).toThrow('skipped bytes');
+    // Nothing was written by the rejected request.
+    expect(statSync(path).size).toBe(PARTS[0].length);
+  });
+
+  it('refuses an inconsistent overlap but accepts an identical replay', () => {
+    const { batchId, itemId } = staged();
+    batches.stage(batchId, itemId, 0, chunk(PARTS[0]));
+    // Same range, same bytes: a retried request, not a rewrite.
+    expect(batches.stage(batchId, itemId, 0, chunk(PARTS[0]))).toMatchObject({ replayed: true });
+    // Same range, different bytes: rejected, the staged data is unchanged.
+    expect(() => batches.stage(batchId, itemId, 0, chunk(Buffer.from('ZZZ-part-one\n')))).toThrow('does not match');
+    // Partially overlapping the staged prefix: rejected.
+    expect(() => batches.stage(batchId, itemId, 4, chunk(PARTS[1]))).toThrow('overlaps');
+  });
+
+  it('refuses a chunk that runs past the declared size', () => {
+    const { batchId, itemId } = staged('book.txt', 10);
+    expect(() => batches.stage(batchId, itemId, 0, chunk(Buffer.alloc(11, 65)))).toThrow('exceeds the declared size');
+  });
+
+  it('refuses a wrong order even when the total length would match', () => {
+    const { batchId, itemId, path } = staged();
+    batches.stage(batchId, itemId, 0, chunk(PARTS[0]));
+    // The "second" chunk is actually the third part: accepted byte-wise, so the
+    // file is wrong. The defence is that the importer parses exactly the bytes
+    // that were uploaded and the client can only append what it acknowledged.
+    batches.stage(batchId, itemId, PARTS[0].length, chunk(PARTS[2]));
+    expect(() => batches.stage(batchId, itemId, 0, chunk(PARTS[1]))).toThrow('does not match');
+    expect(statSync(path).size).toBe(PARTS[0].length + PARTS[2].length);
+  });
+
+  it('cannot pretend a short file is complete', () => {
+    const { batchId, itemId } = staged();
+    batches.stage(batchId, itemId, 0, chunk(PARTS[0]));
+    // The declared size is still the whole book; the batch cannot start from a
+    // truncated file because launch() re-reads the real length.
+    expect(lib.importBatches().at(-1)!.items[0].size).toBe(WHOLE.length);
+    batches.start(batchId);
+    return new Promise<void>((resolve, reject) => {
+      const started = Date.now();
+      const poll = setInterval(() => {
+        const item = lib.importBatches().at(-1)!.items[0];
+        if (item.status === 'needs_reselect' || item.status === 'failed') { clearInterval(poll); resolve(); return; }
+        if (Date.now() - started > 20_000) { clearInterval(poll); reject(new Error('timeout')); }
+      }, 50);
+    }).then(() => {
+      expect(lib.importBatches().at(-1)!.items[0].status).toBe('needs_reselect');
+      expect(lib.list()).toEqual([]);
+    });
+  });
+
+  it('re-upload after reselect restores the same item instead of creating a new one', async () => {
+    const body = Buffer.from('# 重选\n\n' + 'the sea is wide. '.repeat(20));
+    const { batchId, itemId } = staged('again.txt', body.length);
+    // Lose the staged bytes the way an interrupted process would.
+    batches.start(batchId);
+    await new Promise<void>((resolve) => setTimeout(resolve, 400));
+    await batches.shutdown();
+    lib.updateImportBatch(batchId, (draft) => { draft.status = 'running'; draft.items[0].status = 'validating'; });
+    batches = new ImportBatches(lib, join(dir, 'transfers'), { now });
+    batches.resume();
+    const afterResume = lib.importBatches().at(-1)!.items[0];
+    // Either it resumed from the bytes or it asked for the file again.
+    expect(['pending', 'needs_reselect', 'processing', 'completed']).toContain(afterResume.status);
+
+    const lost = batches.reselect(batchId, itemId, { size: body.length });
+    expect(lost).toMatchObject({ itemId, size: body.length, offset: 0 });
+    expect(lib.importBatches().at(-1)!.items[0].id).toBe(itemId);
+    expect(lib.importBatches().at(-1)!.items).toHaveLength(1);
+    // A different file is refused: the entry can only be restored, not swapped.
+    lib.updateImportBatch(batchId, (draft) => { draft.items[0].status = 'needs_reselect'; });
+    expect(() => batches.reselect(batchId, itemId, { size: body.length + 1 })).toThrow(/expects a .* byte file/u);
+    // And an item that never lost its file cannot be reselected at all.
+    lib.updateImportBatch(batchId, (draft) => { draft.items[0].status = 'pending'; });
+    expect(() => batches.reselect(batchId, itemId, { size: body.length })).toThrow('lost its file');
+  });
+});
+
+describe('the ZIP upload follows the same rules', () => {
+  it('refuses a gap, an inconsistent overlap and a mismatched declared size', () => {
+    const batch = batches.create({ source: 'zip' });
+    batches.zipBegin(batch.id, { name: 'a.zip', size: 12 });
+    expect(() => batches.zipChunk(batch.id, 4, chunk(Buffer.from('abcd')))).toThrow('skipped bytes');
+    batches.zipChunk(batch.id, 0, chunk(Buffer.from('abcd')));
+    expect(batches.zipChunk(batch.id, 0, chunk(Buffer.from('abcd')))).toMatchObject({ replayed: true });
+    expect(() => batches.zipChunk(batch.id, 0, chunk(Buffer.from('wxyz')))).toThrow('does not match');
+    expect(() => batches.zipChunk(batch.id, 2, chunk(Buffer.from('cdefgh')))).toThrow('overlaps');
+  });
+});
diff --git a/tests/import-batch-run.test.ts b/tests/import-batch-run.test.ts
new file mode 100644
index 0000000..d49d0ee
--- /dev/null
+++ b/tests/import-batch-run.test.ts
@@ -0,0 +1,259 @@
+import { afterEach, beforeEach, describe, expect, it } from 'vitest';
+import { createWriteStream, existsSync, mkdtempSync, readFileSync, rmSync, statSync, unlinkSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { Library } from '../src/library.ts';
+import { ImportBatches } from '../src/import-batches.ts';
+import { batchStagingName } from '../src/import-batch.ts';
+
+let dir: string, lib: Library, batches: ImportBatches, time: number;
+const now = () => time;
+
+async function waitFor(predicate: () => boolean, label = 'condition', timeout = 40_000): Promise<void> {
+  const start = Date.now();
+  while (Date.now() - start < timeout) {
+    if (predicate()) return;
+    await new Promise((resolve) => setTimeout(resolve, 40));
+  }
+  throw new Error(`Timed out waiting for ${label}`);
+}
+
+function putFile(batchId: string, itemId: string, bytes: Buffer): void {
+  batches.stage(batchId, itemId, 0, bytes.toString('base64'));
+}
+
+function findItem(batchId: string, name: string) {
+  const batch = lib.importBatches().find((row) => row.id === batchId)!;
+  return batch.items.find((item) => item.name === name)!;
+}
+
+function settled(batchId: string): boolean {
+  const batch = lib.importBatches().find((row) => row.id === batchId);
+  return !!batch && (batch.status === 'completed' || batch.status === 'cancelled');
+}
+
+beforeEach(() => {
+  dir = mkdtempSync(join(tmpdir(), 'bookfish-import-batch-'));
+  time = Date.parse('2026-10-01T08:00:00Z');
+  lib = new Library({ dataDir: dir, now });
+  lib.open();
+  batches = new ImportBatches(lib, join(dir, 'transfers'), { now });
+});
+afterEach(async () => {
+  await batches.shutdown();
+  lib.close();
+  rmSync(dir, { recursive: true, force: true });
+});
+
+const NOVEL = (title: string) => Buffer.from(`# ${title}\n\n` + '海边的风把鱼吹得很胖。'.repeat(400));
+
+describe('batch import runs the existing single-file pipeline', () => {
+  it('imports several files, keeps the shelf order and never queues reading', async () => {
+    const batch = batches.create({ source: 'files' });
+    batches.addItems(batch.id, [
+      { name: '甲.txt', size: NOVEL('甲').length, title: '甲' },
+      { name: '乙.txt', size: NOVEL('乙').length, title: '乙' },
+      { name: '丙.txt', size: NOVEL('丙').length, title: '丙' },
+    ]);
+    for (const item of lib.importBatches()[0].items) putFile(batch.id, item.id, NOVEL(item.title));
+    const before = lib.list().length;
+    batches.start(batch.id);
+    await waitFor(() => settled(batch.id), 'batch completion');
+    const done = lib.importBatches().find((row) => row.id === batch.id)!;
+    expect(done.status).toBe('completed');
+    expect(done.items.map((item) => item.status)).toEqual(['completed', 'completed', 'completed']);
+    expect(done.items.every((item) => !!item.bookKey)).toBe(true);
+    expect(lib.list().length).toBe(before + 3);
+    // Importing is not planning: the plan stays empty until the user asks.
+    expect(lib.planView().items).toEqual([]);
+    expect(lib.status().current).toBeNull();
+    // Staging bytes are reclaimed once the item settles.
+    for (const item of done.items) expect(existsSync(join(dir, 'transfers', 'batches', batch.id, batchStagingName(item.id)))).toBe(false);
+  });
+
+  it('reports an identical revision as a duplicate instead of importing it twice', async () => {
+    const text = NOVEL('重复本');
+    const first = batches.create({ source: 'files' });
+    batches.addItems(first.id, [{ name: '重复本.txt', size: text.length, title: '重复本' }]);
+    putFile(first.id, lib.importBatches()[0].items[0].id, text);
+    batches.start(first.id);
+    await waitFor(() => settled(first.id), 'first import');
+    const before = lib.list().length;
+
+    const second = batches.create({ source: 'files' });
+    batches.addItems(second.id, [{ name: '重复本.txt', size: text.length, title: '重复本' }]);
+    putFile(second.id, lib.importBatches().at(-1)!.items[0].id, text);
+    batches.start(second.id);
+    await waitFor(() => settled(second.id), 'duplicate import');
+    const done = lib.importBatches().at(-1)!;
+    expect(done.items[0].status).toBe('completed');
+    expect(done.items[0].duplicate).toBe('identical');
+    expect(lib.list().length).toBe(before);
+  });
+
+  it('surfaces a rejected body as a failed item without stopping the others', async () => {
+    const good = NOVEL('好本');
+    const batch = batches.create({ source: 'files' });
+    batches.addItems(batch.id, [
+      { name: '好本.txt', size: good.length, title: '好本' },
+      { name: '坏本.txt', size: 64, title: '坏本' },
+    ]);
+    const items = lib.importBatches()[0].items;
+    putFile(batch.id, items[0].id, good);
+    putFile(batch.id, items[1].id, Buffer.from('\u0000\u0001 binary garbage \u0002'.padEnd(64, 'x')));
+    batches.start(batch.id);
+    await waitFor(() => settled(batch.id), 'mixed batch');
+    const done = lib.importBatches()[0];
+    expect(done.items[0].status).toBe('completed');
+    expect(done.items[1].status).toBe('failed');
+    expect(done.items[1].error).toBeTruthy();
+    expect(done.status).toBe('completed');
+  });
+
+  it('cancels one waiting item and keeps importing the rest', async () => {
+    const batch = batches.create({ source: 'files' });
+    batches.addItems(batch.id, [
+      { name: 'a.txt', size: NOVEL('a').length, title: 'a' },
+      { name: 'b.txt', size: NOVEL('b').length, title: 'b' },
+    ]);
+    const items = lib.importBatches()[0].items;
+    for (const item of items) putFile(batch.id, item.id, NOVEL(item.title));
+    batches.start(batch.id);
+    batches.cancelOne(batch.id, items[0].id);
+    await waitFor(() => settled(batch.id), 'batch after cancelling one item');
+    const done = lib.importBatches()[0];
+    expect(done.items.map((item) => item.status).sort()).toEqual(['cancelled', 'completed']);
+    // A cancelled item can rejoin the queue and finish from the same staged bytes.
+    batches.retry(batch.id, items[0].id);
+    await waitFor(() => lib.importBatches()[0].items[0].status === 'completed', 'retried item');
+    expect(lib.importBatches()[0].items[0]).toMatchObject({ status: 'completed' });
+  });
+
+  it('recovers an interrupted batch after a restart and resumes the item whose bytes survived', async () => {
+    const text = NOVEL('重启本');
+    const batch = batches.create({ source: 'files' });
+    batches.addItems(batch.id, [{ name: '重启本.txt', size: text.length, title: '重启本' }]);
+    const item = lib.importBatches()[0].items[0];
+    putFile(batch.id, item.id, text);
+    // Simulate a process death in the middle of parsing.
+    lib.updateImportBatch(batch.id, (draft) => {
+      draft.status = 'running';
+      draft.items[0].status = 'processing';
+      draft.items[0].attempts = 1;
+    });
+    await batches.shutdown();
+    lib.close();
+
+    lib = new Library({ dataDir: dir, now });
+    lib.open();
+    batches = new ImportBatches(lib, join(dir, 'transfers'), { now });
+    const report = batches.resume();
+    expect(report).toEqual({ resumed: 1, reselect: 0 });
+    await waitFor(() => settled(batch.id), 'resumed batch');
+    const done = lib.importBatches()[0];
+    expect(done.items[0].status).toBe('completed');
+    expect(lib.list()).toHaveLength(1);
+  });
+
+  it('marks an interrupted batch for reselect when the staged bytes are gone', async () => {
+    const text = NOVEL('丢字节');
+    const batch = batches.create({ source: 'files' });
+    batches.addItems(batch.id, [{ name: '丢字节.txt', size: text.length, title: '丢字节' }]);
+    const item = lib.importBatches()[0].items[0];
+    putFile(batch.id, item.id, text);
+    lib.updateImportBatch(batch.id, (draft) => {
+      draft.status = 'running';
+      draft.items[0].status = 'validating';
+    });
+    unlinkSync(join(dir, 'transfers', 'batches', batch.id, batchStagingName(item.id)));
+    await batches.shutdown();
+    lib.close();
+
+    lib = new Library({ dataDir: dir, now });
+    lib.open();
+    batches = new ImportBatches(lib, join(dir, 'transfers'), { now });
+    expect(batches.resume()).toEqual({ resumed: 0, reselect: 1 });
+    const done = lib.importBatches()[0];
+    expect(done.items[0].status).toBe('needs_reselect');
+    expect(done.items[0].error).toContain('重新选择');
+    expect(done.items[0].attempts).toBe(0);
+  });
+});
+
+describe('a folder or ZIP keeps the internal structure for grouping', () => {
+  it('previews a folder split and refuses to auto-merge the parts', () => {
+    const batch = batches.create({ source: 'folder' });
+    batches.addItems(batch.id, [
+      { name: '长篇小说/1.txt', size: 10, title: '长篇小说' },
+      { name: '长篇小说/2.txt', size: 10, title: '长篇小说' },
+      { name: '长篇小说/3.txt', size: 10, title: '长篇小说' },
+    ]);
+    const preview = batches.status(batch.id);
+    expect(preview.count).toBe(3);
+    expect(preview.groups).toHaveLength(1);
+    expect(preview.groups[0]).toMatchObject({ mayBeSplitNovel: true, ambiguous: true });
+    // Nothing was merged into the plan; the proposal is only a proposal.
+    expect(lib.planView().items).toEqual([]);
+  });
+
+  it('imports the supported entries of a ZIP and reports the rest', async () => {
+    const yazl = await import('yazl');
+    const zipPath = join(dir, 'books.zip');
+    const zip = new yazl.ZipFile();
+    zip.addBuffer(NOVEL('卷一'), '系列/01 第一部.txt');
+    zip.addBuffer(NOVEL('卷二'), '系列/02 第二部.txt');
+    zip.addBuffer(Buffer.from('not a novel'), '系列/cover.jpg');
+    zip.addBuffer(Buffer.from('hidden'), '__MACOSX/._01.txt');
+    zip.end();
+    await new Promise<void>((resolve, reject) => {
+      const out = createWriteStream(zipPath);
+      out.on('close', () => resolve()).on('error', reject);
+      zip.outputStream.pipe(out);
+    });
+
+    const batch = batches.create({ source: 'zip' });
+    batches.zipBegin(batch.id, { name: 'books.zip', size: statSync(zipPath).size });
+    const bytes = readFileSync(zipPath);
+    for (let offset = 0; offset < bytes.length; offset += 64 * 1024) {
+      batches.zipChunk(batch.id, offset, bytes.subarray(offset, Math.min(offset + 64 * 1024, bytes.length)).toString('base64'));
+    }
+    const added = await batches.zipFinish(batch.id);
+    expect(added.added.map((item) => item.name)).toEqual(['系列/01 第一部.txt', '系列/02 第二部.txt']);
+    expect(added.unsupported).toEqual(['系列/cover.jpg']);
+    const preview = batches.status(batch.id);
+    expect(preview.count).toBe(2);
+    batches.start(batch.id);
+    await waitFor(() => settled(batch.id), 'zip batch');
+    const done = lib.importBatches()[0];
+    expect(done.items.map((item) => item.status)).toEqual(['completed', 'completed']);
+    // The title comes from the entry name, exactly like a one-file import.
+    expect(lib.list().map((book) => book.title).sort()).toEqual(['01 第一部', '02 第二部']);
+  });
+});
+
+describe('the plan hand-off stays an explicit second step', () => {
+  it('adds completed books to the plan only when asked, and groups them on request', async () => {
+    const batch = batches.create({ source: 'folder' });
+    batches.addItems(batch.id, [
+      { name: '三部曲/01 第一部.txt', size: NOVEL('第一部').length, title: '三部曲 第一部' },
+      { name: '三部曲/02 第二部.txt', size: NOVEL('第二部').length, title: '三部曲 第二部' },
+    ]);
+    for (const item of lib.importBatches()[0].items) putFile(batch.id, item.id, NOVEL(item.title.replace('三部曲 ', '')));
+    batches.start(batch.id);
+    await waitFor(() => settled(batch.id), 'batch before planning');
+    expect(lib.planView().items).toEqual([]);
+
