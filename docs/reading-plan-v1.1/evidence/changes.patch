+        });
+      }
+    }
+
+    const actions = el('div', '', body); actions.className = 'batch-actions';
+    if (view.status === 'preview') {
+      act(say('开始导入', 'Start import'), actions, async () => { await ctx.invoke('import_batch_start', [state.batch!.id]); await refresh(); });
