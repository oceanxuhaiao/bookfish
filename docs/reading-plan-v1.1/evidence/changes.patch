+    }
+  }
+
+  // Reopening the panel must never lose the way back into a half-finished batch.
+  void refreshSummaries().catch(fail);
+
+  return { root,
+    dispose() {
+      disposed = true;
+      if (timer) clearTimeout(timer);
+      timer = undefined;
+    } };
+}
