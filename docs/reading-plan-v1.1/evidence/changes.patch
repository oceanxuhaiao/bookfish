@@ -0,0 +1,129 @@
+import { afterEach, beforeEach, describe, expect, it } from 'vitest';
+import { mkdtempSync, rmSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { Library } from '../src/library.ts';
+
+let dir: string, time: number, lib: Library;
+const now = () => time;
+const idle = { routine: null, restUntil: null, active: undefined } as const;
+
+function open() { lib = new Library({ dataDir: dir, now }); lib.open(); }
+function close() { lib.close(); }
+
+beforeEach(() => {
+  dir = mkdtempSync(join(tmpdir(), 'bookfish-plan-combo-'));
+  time = Date.parse('2026-10-10T02:00:00Z');
+  open();
+});
+afterEach(() => { try { lib.close(); } catch { /* already closed */ } rmSync(dir, { recursive: true, force: true }); });
+
+const seed = (titles: string[]) => titles.map((title) => lib.import({ filename: `${title}.txt`, title,
+  base64: Buffer.from(`# ${title}\n` + '海风。'.repeat(900)).toString('base64') }).book);
+
+function finish(key: string) {
+  lib.select(key);
+  for (let guard = 0; guard < 40; guard++) {
+    const read = lib.readNext(4);
+    if (read.complete) return;
+    lib.finishMany(read.segments.map((segment) => ({ taskId: segment.taskId, segmentId: segment.segmentId, understanding: '' })));
+  }
+  throw new Error('book did not finish');
+}
+
+describe('user reordering and an automatic hand-off can happen in either order', () => {
+  it('honours the order the user set just before the hand-off', () => {
+    const [a, b, c] = seed(['甲', '乙', '丙']);
+    lib.addToPlan([a.key, b.key, c.key], { source: 'user' });
+    finish(a.key);
+    // The user moves C right after A while A is finishing.
+    lib.updatePlanAction({ action: 'place', itemId: lib.planView().items[2].id, place: 'next' });
+    expect(lib.planView().items.map((row) => row.bookKey)).toEqual([a.key, c.key, b.key]);
+    expect(lib.advancePlan(idle)).toMatchObject({ advanced: true, to: c.key });
+    expect(lib.status().current!.key).toBe(c.key);
+    expect(lib.planView().items.map((row) => row.bookKey)).toEqual([c.key, b.key]);
+    expect(lib.planView().completedCount).toBe(1);
+  });
+
+  it('keeps a reorder that arrives after the hand-off coherent', () => {
+    const [a, b, c] = seed(['甲', '乙', '丙']);
+    lib.addToPlan([a.key, b.key, c.key], { source: 'user' });
+    finish(a.key);
+    expect(lib.advancePlan(idle)).toMatchObject({ advanced: true, to: b.key });
+    // B is being read, so nothing may be placed before it.
+    lib.updatePlanAction({ action: 'place', itemId: lib.planView().items[1].id, place: 'top' });
+    const view = lib.planView();
+    expect(view.items.map((row) => row.bookKey)).toEqual([b.key, c.key]);
+    expect(view.current?.bookKey).toBe(b.key);
+    expect(lib.selection().queue.map((row) => row.bookKey)).toEqual([b.key, c.key]);
+  });
+
+  it('rejects reordering the book that is being read', () => {
+    const [a, b] = seed(['甲', '乙']);
+    lib.addToPlan([a.key, b.key], { source: 'user' });
+    lib.select(a.key);
+    const activeItem = lib.planView().items[0];
+    expect(() => lib.updatePlanAction({ action: 'move', itemId: activeItem.id, to: 2 })).toThrow('locked');
+    expect(() => lib.updatePlanAction({ action: 'place', itemId: activeItem.id, place: 'bottom' })).toThrow('locked');
+    expect(lib.planView().items.map((row) => row.bookKey)).toEqual([a.key, b.key]);
+  });
+});
+
+describe('a completion callback that arrives while the user paused', () => {
+  it('records the completion but does not switch books', () => {
+    const [a, b] = seed(['甲', '乙']);
+    lib.addToPlan([a.key, b.key], { source: 'user' });
+    finish(a.key);
+    lib.setPaused(true);
+    expect(lib.advancePlan(idle)).toEqual({ advanced: false, reason: 'paused' });
+    // The plan tells the truth even though nothing was switched.
+    expect(lib.planView().completedCount).toBe(1);
+    expect(lib.planView().items.map((row) => row.bookKey)).toEqual([b.key]);
+    expect(lib.status().current!.key).toBe(a.key);
+    // Resuming lets the same completion finish its hand-off.
+    lib.setPaused(false);
+    expect(lib.advancePlan(idle)).toMatchObject({ advanced: true, to: b.key });
+    expect(lib.planView().completedCount).toBe(1);
+  });
+
+  it('does not switch while a daily routine gate is closed', () => {
+    const [a, b] = seed(['甲', '乙']);
+    lib.addToPlan([a.key, b.key], { source: 'user' });
+    finish(a.key);
+    expect(lib.advancePlan({ ...idle, routine: { kind: 'sleep' } })).toEqual({ advanced: false, reason: 'routine' });
+    expect(lib.planView().completedCount).toBe(1);
+    expect(lib.status().current!.key).toBe(a.key);
+    expect(lib.advancePlan(idle).advanced).toBe(true);
+  });
+});
+
+describe('a review pending across a restart is settled, never silently dropped', () => {
+  it('blocks the hand-off while the job is alive and continues once it is terminal', () => {
+    const [a, b] = seed(['甲', '乙']);
+    lib.addToPlan([a.key, b.key], { source: 'user' });
+    finish(a.key);
+    const job = lib.beginReview({ bookKey: a.key, requestId: 'combo-review' }).job;
+    expect(lib.advancePlan(idle)).toEqual({ advanced: false, reason: 'review_pending' });
+
+    // A restart cannot resume a half-finished cognition job: it is cancelled with
+    // a recorded reason, which is a terminal state and therefore allows the
+    // hand-off. The completion itself was already archived before the restart.
+    close(); open();
+    expect(lib.planView().completedCount).toBe(1);
+    expect(lib.status().current!.key).toBe(a.key);
+    expect(lib.advancePlan(idle)).toMatchObject({ advanced: true, to: b.key });
+    expect(lib.planView().completedCount).toBe(1);
+    expect(lib.planView().archive.filter((row) => row.bookKey === a.key)).toHaveLength(1);
+    expect(lib.reviews(a.key).jobs.find((row) => row.id === job.id)?.status).toBe('cancelled');
+  });
+
+  it('continues after an explicit terminal failure without a restart', () => {
+    const [a, b] = seed(['甲', '乙']);
+    lib.addToPlan([a.key, b.key], { source: 'user' });
+    finish(a.key);
+    const job = lib.beginReview({ bookKey: a.key, requestId: 'combo-review-2' }).job;
+    expect(lib.advancePlan(idle)).toEqual({ advanced: false, reason: 'review_pending' });
+    lib.failReview({ jobId: job.id, reason: 'gave up' });
+    expect(lib.advancePlan(idle)).toMatchObject({ advanced: true, to: b.key });
+  });
+});
diff --git a/tests/plan-stop-atomic.test.ts b/tests/plan-stop-atomic.test.ts
new file mode 100644
index 0000000..4e92736
--- /dev/null
+++ b/tests/plan-stop-atomic.test.ts
@@ -0,0 +1,173 @@
+import { afterEach, beforeEach, describe, expect, it } from 'vitest';
+import { closeSync, fsyncSync, mkdtempSync, openSync, renameSync, rmSync, writeFileSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { Library } from '../src/library.ts';
+
+let dir: string, time: number, lib: Library;
+let failure: Error | null = null;
+const now = () => time;
+const idle = { routine: null, restUntil: null, active: undefined } as const;
+
+/**
+ * Every write goes through the injected commit path, so a single flag can make
+ * the *next* snapshot fail exactly the way a crashed or full disk would.
+ */
+function open() {
+  lib = new Library({ dataDir: dir, now, write: (file, state) => {
+    if (failure) throw failure;
+    const temporary = `${file}.${process.pid}.${Math.random().toString(16).slice(2)}.tmp`;
+    const fd = openSync(temporary, 'wx');
+    try { writeFileSync(fd, JSON.stringify(state), 'utf8'); fsyncSync(fd); } finally { closeSync(fd); }
+    renameSync(temporary, file);
+  } });
+  lib.open();
+}
+function close() { lib.close(); }
+
+beforeEach(() => {
+  dir = mkdtempSync(join(tmpdir(), 'bookfish-plan-stop-'));
+  time = Date.parse('2026-10-05T02:00:00Z');
+  failure = null;
+  open();
+});
+afterEach(() => { failure = null; try { lib.close(); } catch { /* already closed */ } rmSync(dir, { recursive: true, force: true }); });
+
+const seed = (titles: string[]) => titles.map((title) => lib.import({ filename: `${title}.txt`, title,
+  base64: Buffer.from(`# ${title}\n` + '海风。'.repeat(900)).toString('base64') }).book);
+
+function readOne(key: string) {
+  lib.select(key);
+  const read = lib.readNext(1);
+  if (read.complete) throw new Error('expected text');
+  lib.finishMany(read.segments.map((segment) => ({ taskId: segment.taskId, segmentId: segment.segmentId, understanding: '' })));
+}
+
+describe('stopping the current book is one atomic decision', () => {
+  it('archives, invalidates and switches in a single commit', () => {
+    const [a, b] = seed(['甲', '乙']);
+    lib.addToPlan([a.key, b.key], { source: 'user' });
+    readOne(a.key);
+    const pending = lib.readNext(1);
+    expect(pending.complete).toBe(false);
+    const progress = lib.list().find((book) => book.key === a.key)!.confirmedChars;
+    const item = lib.planView().items.find((row) => row.bookKey === a.key)!;
+    const result = lib.removeFromPlan(item.id, { status: 'skipped', stop: true, reason: 'stopped_by_user' });
+    expect(result.to).toBe(b.key);
+    expect(result.entry).toMatchObject({ bookKey: a.key, status: 'skipped' });
+    expect(lib.status().current!.key).toBe(b.key);
+    // The stopped book keeps every confirmed character and its unread text.
+    const stopped = lib.list().find((book) => book.key === a.key)!;
+    expect(stopped.confirmedChars).toBe(progress);
+    expect(stopped.complete).toBe(false);
+    // The stale offer on the old book is gone, not just ignored.
+    expect(lib.status().pending).toBeFalsy();
+    expect(lib.status().current!.key).toBe(b.key);
+    // Plan, selection and startedAt agree.
+    const view = lib.planView();
+    expect(view.items.map((row) => row.bookKey)).toEqual([b.key]);
+    expect(view.current?.bookKey).toBe(b.key);
+    expect(view.current?.startedAt).toBe(time);
+    expect(view.completedCount).toBe(0);
+  });
+
+  it('skips a deferred entry and picks the next readable one', () => {
+    const [a, b, c] = seed(['甲', '乙', '丙']);
+    lib.addToPlan([a.key, b.key, c.key], { source: 'user' });
+    readOne(a.key);
+    const deferred = lib.planView().items.find((row) => row.bookKey === b.key)!;
+    lib.updatePlan((plan) => { plan.items.find((row) => row.id === deferred.id)!.notBefore = time + 86_400_000; plan.revision += 1; });
+    const item = lib.planView().items.find((row) => row.bookKey === a.key)!;
+    expect(lib.removeFromPlan(item.id, { status: 'skipped', stop: true }).to).toBe(c.key);
+    expect(lib.status().current!.key).toBe(c.key);
+  });
+
+  it('leaves nothing behind when the commit fails, and the retry then succeeds', () => {
+    const [a, b] = seed(['甲', '乙']);
+    lib.addToPlan([a.key, b.key], { source: 'user' });
+    readOne(a.key);
+    const progress = lib.list().find((book) => book.key === a.key)!.confirmedChars;
+    const before = lib.planView();
+    const item = before.items.find((row) => row.bookKey === a.key)!;
+
+    failure = new Error('disk full while writing the plan');
+    expect(() => lib.removeFromPlan(item.id, { status: 'skipped', stop: true })).toThrow('disk full');
+    failure = null;
+
+    // Not one field moved: the entry, the selection and the progress are intact.
+    const after = lib.planView();
+    expect(after.items.map((row) => row.bookKey)).toEqual([a.key, b.key]);
+    expect(after.archive).toEqual([]);
+    expect(lib.status().current!.key).toBe(a.key);
+    expect(lib.list().find((book) => book.key === a.key)!.confirmedChars).toBe(progress);
+
+    // The same request retried later behaves as if nothing had happened.
+    expect(lib.removeFromPlan(item.id, { status: 'skipped', stop: true }).to).toBe(b.key);
+    expect(lib.planView().items.map((row) => row.bookKey)).toEqual([b.key]);
+  });
+
+  it('reopens into a state that can continue reading, both after success and after failure', () => {
+    const [a, b] = seed(['甲', '乙']);
+    lib.addToPlan([a.key, b.key], { source: 'user' });
+    readOne(a.key);
+    const item = lib.planView().items.find((row) => row.bookKey === a.key)!;
+
+    failure = new Error('interrupted before commit');
+    expect(() => lib.removeFromPlan(item.id, { status: 'skipped', stop: true })).toThrow();
+    failure = null;
+    close(); open();
+    expect(lib.planView().items.map((row) => row.bookKey)).toEqual([a.key, b.key]);
+    expect(lib.status().current!.key).toBe(a.key);
+    // A restarted process can still advance: nothing was half-applied.
+    const read = lib.readNext(1);
+    expect(read.complete).toBe(false);
+
+    lib.cancelPending();
+    lib.removeFromPlan(item.id, { status: 'skipped', stop: true });
+    close(); open();
+    expect(lib.planView().items.map((row) => row.bookKey)).toEqual([b.key]);
+    expect(lib.status().current!.key).toBe(b.key);
+    expect(lib.planView().current?.startedAt).toBe(time);
+  });
+
+  it('never reports a switched selection without its plan entry', () => {
+    const [a, b] = seed(['甲', '乙']);
+    lib.addToPlan([a.key, b.key], { source: 'user' });
+    readOne(a.key);
+    const item = lib.planView().items.find((row) => row.bookKey === a.key)!;
+    lib.removeFromPlan(item.id, { status: 'skipped', stop: true });
+    const view = lib.planView();
+    const current = view.current;
+    expect(current).not.toBeNull();
+    expect(view.items.some((row) => row.bookKey === lib.status().current!.key)).toBe(true);
+    expect(current!.startedAt).toBeDefined();
+    // The stopped book is history now, and it is not silently marked finished.
+    expect(view.archive.find((row) => row.bookKey === a.key)).toMatchObject({ status: 'skipped' });
+    expect(view.completedCount).toBe(0);
+  });
+
+  it('refuses the stop when the only other planned book is deferred', () => {
+    const [a, b] = seed(['甲', '乙']);
+    lib.addToPlan([a.key, b.key], { source: 'user' });
+    readOne(a.key);
+    const deferred = lib.planView().items.find((row) => row.bookKey === b.key)!;
+    lib.updatePlan((plan) => { plan.items.find((row) => row.id === deferred.id)!.notBefore = time + 3_600_000; plan.revision += 1; });
+    const item = lib.planView().items.find((row) => row.bookKey === a.key)!;
+    expect(() => lib.removeFromPlan(item.id, { status: 'skipped', stop: true })).toThrow('No other planned book');
+    expect(lib.planView().items).toHaveLength(2);
+    expect(lib.status().current!.key).toBe(a.key);
+  });
+
+  it('stops a book that the plan was not driving, without touching the plan order', () => {
+    const [a, b] = seed(['甲', '乙']);
+    lib.addToPlan([a.key, b.key], { source: 'user' });
+    // Read B as the selected book while A is first in the plan.
+    readOne(b.key);
+    const itemB = lib.planView().items.find((row) => row.bookKey === b.key)!;
+    lib.removeFromPlan(itemB.id, { status: 'skipped', stop: true });
+    expect(lib.status().current!.key).toBe(a.key);
+    expect(lib.planView().items.map((row) => row.bookKey)).toEqual([a.key]);
+    expect(lib.planView().current?.startedAt).toBe(time);
+    void idle;
+  });
+});
diff --git a/tests/reading-plan-core.test.ts b/tests/reading-plan-core.test.ts
new file mode 100644
index 0000000..2ffa075
--- /dev/null
+++ b/tests/reading-plan-core.test.ts
@@ -0,0 +1,176 @@
+import { describe, expect, it } from 'vitest';
+import {
+  addPlanItems, archiveItem, createSeries, dropUnusedSeries, emptyPlan, findItem, markStarted,
+  migrateLegacyQueue, movePlanItem, movePlanSeries, orderSuggestion, reconcilePlan, setItemNotBefore,
+  setItemSeries, setPlanEnabled, suggestSeries, validatePlan, volumeOf, PLAN_ITEM_LIMIT,
+} from '../src/reading-plan.ts';
+
+const NOW = Date.parse('2026-10-01T08:00:00Z');
+
+function planWith(keys: string[]) {
+  const plan = emptyPlan(NOW);
+  addPlanItems(plan, keys.map((bookKey) => ({ bookKey, title: bookKey.toUpperCase(), source: 'user' as const })), NOW);
+  return plan;
+}
+
+describe('reading plan core is pure and order-only', () => {
+  it('appends in the requested order and keeps the first occurrence', () => {
+    const plan = planWith(['a', 'b', 'c']);
+    expect(plan.items.map((item) => item.bookKey)).toEqual(['a', 'b', 'c']);
+    const again = addPlanItems(plan, [{ bookKey: 'b', title: 'B', source: 'user' }, { bookKey: 'd', title: 'D', source: 'persona' }], NOW + 1);
+    expect(again.added.map((item) => item.bookKey)).toEqual(['d']);
+    expect(again.duplicates).toEqual(['b']);
+    expect(plan.items.map((item) => item.bookKey)).toEqual(['a', 'b', 'c', 'd']);
+    expect(plan.items[3].source).toBe('persona');
+  });
+
+  it('re-adds a book that was archived as skipped but never resurrects a completed one', () => {
+    const plan = planWith(['a', 'b']);
+    const skipped = plan.items[1];
+    archiveItem(plan, skipped.id, 'skipped', NOW + 2, 'not_now');
+    const afterSkip = addPlanItems(plan, [{ bookKey: 'b', title: 'B', source: 'user' }], NOW + 3);
+    expect(afterSkip.added.map((item) => item.bookKey)).toEqual(['b']);
+    expect(afterSkip.archived).toEqual([]);
+
+    const readded = plan.items.find((item) => item.bookKey === 'b')!;
+    archiveItem(plan, readded.id, 'completed', NOW + 4);
+    const afterComplete = addPlanItems(plan, [{ bookKey: 'b', title: 'B', source: 'user' }], NOW + 5);
+    expect(afterComplete.added).toEqual([]);
+    expect(afterComplete.archived).toEqual(['b']);
+  });
+
+  it('removing never deletes the shelf copy, and the archive keeps the reason', () => {
+    const plan = planWith(['a', 'b']);
+    archiveItem(plan, plan.items[0].id, 'removed', NOW + 2, 'user_dropped_it');
+    expect(plan.items.map((item) => item.bookKey)).toEqual(['b']);
+    expect(plan.archive[0]).toMatchObject({ bookKey: 'a', status: 'removed', reason: 'user_dropped_it' });
+    // Skipped is explicitly not completion.
+    archiveItem(plan, plan.items[0].id, 'skipped', NOW + 3);
+    expect(plan.archive.filter((entry) => entry.status === 'completed')).toHaveLength(0);
+  });
+
+  it('moves one entry and a whole series without reordering anything else', () => {
+    const plan = planWith(['a', 'b', 'c', 'd']);
+    const series = createSeries(plan, '三部曲', 'manual', true, NOW + 2);
+    setItemSeries(plan, plan.items[1].id, series.id, NOW + 3);
+    setItemSeries(plan, plan.items[3].id, series.id, NOW + 4);
+    expect(movePlanItem(plan, plan.items[3].id, 0, NOW + 5)).toBe(true);
+    expect(plan.items.map((item) => item.bookKey)).toEqual(['d', 'a', 'b', 'c']);
+    // The series members move as one contiguous block, keeping their order.
+    expect(movePlanSeries(plan, series.id, 0, NOW + 6)).toBe(true);
+    expect(plan.items.map((item) => item.bookKey)).toEqual(['d', 'b', 'a', 'c']);
+    expect(plan.revision).toBeGreaterThan(0);
+    dropUnusedSeries(plan);
+    expect(plan.series).toHaveLength(1);
+  });
+
+  it('rejects a tampered plan instead of silently repairing it', () => {
+    const plan = planWith(['a', 'b']);
+    expect(() => validatePlan({ ...plan, items: [plan.items[0], { ...plan.items[0], id: plan.items[0].id }] }, NOW)).toThrow();
+    expect(() => validatePlan({ ...plan, items: [{ ...plan.items[0], seriesId: 'missing' }] }, NOW)).toThrow();
+    expect(() => validatePlan({ ...plan, schema: 99 }, NOW)).toThrow();
+    expect(validatePlan(undefined, NOW).items).toEqual([]);
+    expect(PLAN_ITEM_LIMIT).toBeGreaterThan(50);
+  });
+
+  it('limits the plan and reports overflow instead of dropping silently', () => {
+    const plan = emptyPlan(NOW);
+    const inputs = Array.from({ length: PLAN_ITEM_LIMIT + 3 }, (_, index) => ({ bookKey: 'k' + index, title: 'T' + index, source: 'user' as const }));
+    const result = addPlanItems(plan, inputs, NOW);
+    expect(plan.items).toHaveLength(PLAN_ITEM_LIMIT);
+    expect(result.overflow).toBe(3);
+  });
+
+  it('moves shelf-missing entries to the archive instead of blocking the plan', () => {
+    const plan = planWith(['a', 'b', 'c']);
+    expect(reconcilePlan(plan, new Set(['a', 'c']), NOW + 10)).toBe(true);
+    expect(plan.items.map((item) => item.bookKey)).toEqual(['a', 'c']);
+    expect(plan.archive.find((entry) => entry.bookKey === 'b')?.status).toBe('removed');
+    expect(reconcilePlan(plan, new Set(['a', 'c']), NOW + 11)).toBe(false);
+  });
+
+  it('marks a start and honours a deferral without touching order', () => {
+    const plan = planWith(['a', 'b']);
+    markStarted(plan, 'b', NOW + 1);
+    expect(plan.items[1].startedAt).toBe(NOW + 1);
+    expect(plan.items[0].startedAt).toBeUndefined();
+    setItemNotBefore(plan, findItem(plan, 'b')!.id, NOW + 86_400_000, NOW + 2);
+    expect(plan.items[1].notBefore).toBe(NOW + 86_400_000);
+    expect(setPlanEnabled(plan, false, NOW + 3)).toBe(true);
+    expect(plan.enabled).toBe(false);
+    expect(setPlanEnabled(plan, false, NOW + 4)).toBe(false);
+  });
+});
+
+describe('legacy queue migration keeps the old cross-book order', () => {
+  const books = new Map([['a', { title: 'A' }], ['b', { title: 'B' }], ['c', { title: 'C' }]]);
+  const row = (bookKey: string, status: string, addedAt: number, source: 'pet' | 'user' = 'user') => ({
+    id: `row-${bookKey}-${status}`, intentId: `intent-${bookKey}`, bookKey, title: bookKey.toUpperCase(),
+    source, status, addedAt, updatedAt: addedAt + 1,
+  });
+
+  it('maps queued rows to items and terminal rows to the archive', () => {
+    const report = migrateLegacyQueue([
+      row('b', 'queued', NOW + 20, 'pet'),
+      row('a', 'active', NOW + 10),
+      row('c', 'done', NOW + 5),
+    ], books, NOW + 30);
+    expect(report.migrated).toBe(3);
+    expect(report.plan.items.map((item) => item.bookKey)).toEqual(['a', 'b']);
+    expect(report.plan.items[1].source).toBe('persona');
+    expect(report.plan.archive.map((entry) => [entry.bookKey, entry.status])).toEqual([['c', 'completed']]);
+  });
+
+  it('drops rows whose revision is gone and counts them', () => {
+    const report = migrateLegacyQueue([row('gone', 'queued', NOW)], books, NOW + 1);
+    expect(report.migrated).toBe(0);
+    expect(report.dropped).toBe(1);
+    expect(report.plan.items).toEqual([]);
+  });
+
+  it('keeps a cancelled row as removed, never as completed', () => {
+    const report = migrateLegacyQueue([row('a', 'cancelled', NOW)], books, NOW + 1);
+    expect(report.plan.items).toEqual([]);
+    expect(report.plan.archive[0]).toMatchObject({ bookKey: 'a', status: 'removed', reason: 'legacy_cancelled' });
+  });
+});
+
+describe('grouping proposals never merge a split novel behind the user back', () => {
+  it('reads a declared volume number out of a title', () => {
+    expect(volumeOf('斗罗大陆 第二部')).toMatchObject({ volume: 2 });
+    expect(volumeOf('三体（上）')).toMatchObject({ volume: 1 });
+    expect(volumeOf('三体（下）')).toMatchObject({ volume: 3 });
+    expect(volumeOf('某某 卷三')).toMatchObject({ volume: 3 });
+    expect(volumeOf('平凡的世界')).toBeNull();
+  });
+
+  it('proposes a folder group and orders it by volume', () => {
+    const rows = [
+      { bookKey: 'k2', title: '斗罗大陆 第二部', relativePath: '斗罗/2.txt' },
+      { bookKey: 'k1', title: '斗罗大陆 第一部', relativePath: '斗罗/1.txt' },
+    ];
+    const [group] = suggestSeries(rows);
+    expect(group.evidence).toBe('folder');
+    expect(group.name).toBe('斗罗');
+    expect(group.bookKeys).toHaveLength(2);
+    expect(orderSuggestion([{ bookKey: 'k2', title: '斗罗大陆 第二部' }, { bookKey: 'k1', title: '斗罗大陆 第一部' }])).toEqual(['k1', 'k2']);
+  });
+
+  it('flags a title-split that could be one novel as ambiguous', () => {
+    const rows = [
+      { bookKey: 's1', title: '凡人修仙传（一）', relativePath: 'x/1.txt' },
+      { bookKey: 's2', title: '凡人修仙传（二）', relativePath: 'x/2.txt' },
+    ];
+    expect(suggestSeries(rows).every((group) => group.ambiguous === false)).toBe(true);
+    const split = [
+      { bookKey: 'p1', title: '外传', relativePath: 'y/1.txt' },
+      { bookKey: 'p2', title: '外传 番外', relativePath: 'y/2.txt' },
+    ];
+    expect(suggestSeries(split).some((group) => group.ambiguous)).toBe(true);
+  });
+
+  it('ignores a generic folder name', () => {
+    const rows = [{ bookKey: 'a', title: 'A', relativePath: 'txt/a.txt' }, { bookKey: 'b', title: 'B', relativePath: 'txt/b.txt' }];
+    expect(suggestSeries(rows)).toEqual([]);
+  });
+});
diff --git a/tests/reading-plan-library.test.ts b/tests/reading-plan-library.test.ts
new file mode 100644
index 0000000..c9e4abb
--- /dev/null
+++ b/tests/reading-plan-library.test.ts
@@ -0,0 +1,197 @@
+import { afterEach, beforeEach, describe, expect, it } from 'vitest';
+import { mkdtempSync, readFileSync, rmSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { Library } from '../src/library.ts';
+
+let dir: string, time: number, lib: Library;
+const now = () => time;
+
+function open() { lib = new Library({ dataDir: dir, now }); lib.open(); }
+function close() { lib.close(); }
+
+beforeEach(() => {
+  dir = mkdtempSync(join(tmpdir(), 'bookfish-plan-lib-'));
+  time = Date.parse('2026-10-03T02:00:00Z');
+  open();
+});
+afterEach(() => { try { lib.close(); } catch { /* already closed */ } rmSync(dir, { recursive: true, force: true }); });
+
+function seedBooks(titles: string[]) {
+  return titles.map((title) => lib.import({ filename: `${title}.txt`, title,
+    base64: Buffer.from(`第${title}章\n` + '海风。'.repeat(900)).toString('base64') }).book);
+}
+
+describe('the single plan lives in the one atomic snapshot', () => {
+  it('keeps the order across a restart and never renumbers books', () => {
+    const [a, b, c] = seedBooks(['甲', '乙', '丙']);
+    lib.addToPlan([a.key, b.key, c.key], { source: 'user' });
+    const before = lib.planView();
+    expect(before.items.map((item) => item.title)).toEqual(['甲', '乙', '丙']);
+    close(); open();
+    const after = lib.planView();
+    expect(after.items.map((item) => item.bookKey)).toEqual([a.key, b.key, c.key]);
+    expect(after.items.map((item) => item.id)).toEqual(before.items.map((item) => item.id));
+    expect(after.revision).toBe(before.revision);
+  });
+
+  it('stores the plan inside library.json, not in a second store', () => {
+    const [a, b] = seedBooks(['甲', '乙']);
+    lib.addToPlan([a.key, b.key], { source: 'user' });
+    lib.updatePlanAction({ action: 'place', itemId: lib.planView().items[1].id, place: 'top' });
+    const snapshot = JSON.parse(readFileSync(lib.file, 'utf8'));
+    expect(snapshot.plan.schema).toBe(1);
+    expect(snapshot.plan.items.map((item: { bookKey: string }) => item.bookKey)).toEqual([b.key, a.key]);
+    expect(Array.isArray(snapshot.importBatches)).toBe(true);
+  });
+
+  it('reordering changes nothing else: text, progress, journal and reviews stay put', () => {
+    const [a, b, c] = seedBooks(['甲', '乙', '丙']);
+    lib.select(a.key);
+    const read = lib.readNext(1);
+    if (read.complete) throw new Error('expected text');
+    lib.finishMany(read.segments.map((segment) => ({ taskId: segment.taskId, segmentId: segment.segmentId, understanding: '记住这片海。' })));
+    lib.addToPlan([a.key, b.key, c.key], { source: 'user' });
+    const beforeBook = lib.list().find((book) => book.key === a.key)!;
+    const beforeJournal = lib.journal(a.key).items.length;
+    const beforePlan = lib.planView();
+
+    lib.updatePlanAction({ action: 'place', itemId: beforePlan.items[2].id, place: 'next' });
+    expect(lib.planView().items.map((row) => row.bookKey)).toEqual([a.key, c.key, b.key]);
+    lib.updatePlanAction({ action: 'move', itemId: lib.planView().items[2].id, to: 2 });
+    expect(lib.planView().items.map((row) => row.bookKey)).toEqual([a.key, b.key, c.key]);
+
+    const afterBook = lib.list().find((book) => book.key === a.key)!;
+    expect(afterBook.revision).toBe(beforeBook.revision);
+    expect(afterBook.totalChars).toBe(beforeBook.totalChars);
+    expect(afterBook.confirmedChars).toBe(beforeBook.confirmedChars);
+    expect(afterBook.confirmedSegments).toBe(beforeBook.confirmedSegments);
+    expect(lib.journal(a.key).items.length).toBe(beforeJournal);
+    expect(lib.reviews(a.key).versions).toEqual([]);
+    expect(lib.reviews(a.key).jobs).toEqual([]);
+    expect(lib.status().current!.key).toBe(a.key);
+  });
+});
+
+describe('removing, skipping and stopping are three different promises', () => {
+  it('locks the book being read against a plain removal', () => {
+    const [a, b] = seedBooks(['甲', '乙']);
+    lib.select(a.key);
+    lib.addToPlan([a.key, b.key], { source: 'user' });
+    const item = lib.planView().items[0];
+    expect(() => lib.removeFromPlan(item.id, { status: 'removed' })).toThrow('locked');
+    expect(lib.planView().items).toHaveLength(2);
+    expect(lib.status().current!.key).toBe(a.key);
+  });
+
+  it('skips a waiting book without marking it read or losing progress', () => {
+    const [a, b] = seedBooks(['甲', '乙']);
+    lib.select(a.key);
+    const read = lib.readNext(1);
+    if (read.complete) throw new Error('expected text');
+    lib.finishMany(read.segments.map((segment) => ({ taskId: segment.taskId, segmentId: segment.segmentId, understanding: '' })));
+    // Move on so the partially read book is waiting rather than locked.
+    lib.select(b.key);
+    lib.addToPlan([a.key, b.key], { source: 'user' });
+    const progress = lib.list().find((book) => book.key === a.key)!.confirmedChars;
+    // `a` is waiting now; only the active book is locked.
+    const item = lib.planView().items.find((row) => row.bookKey === a.key)!;
+    lib.removeFromPlan(item.id, { status: 'skipped', reason: 'not_now' });
+    const view = lib.planView();
+    expect(view.items.map((row) => row.bookKey)).toEqual([b.key]);
+    expect(view.completedCount).toBe(0);
+    expect(view.archive[0]).toMatchObject({ bookKey: a.key, status: 'skipped', reason: 'not_now' });
+    expect(lib.list().find((book) => book.key === a.key)!.confirmedChars).toBe(progress);
+    expect(lib.list().some((book) => book.key === a.key)).toBe(true);
+    expect(lib.status().current!.key).toBe(b.key);
+    // Skipping is not finishing, so the book can be planned again.
+    lib.addToPlan([a.key], { source: 'user' });
+    expect(lib.planView().items.map((row) => row.bookKey)).toEqual([b.key, a.key]);
+  });
+
+  it('stops the current book only when asked, and keeps every byte of progress', () => {
+    const [a, b] = seedBooks(['甲', '乙']);
+    lib.select(a.key);
+    const read = lib.readNext(1);
+    if (read.complete) throw new Error('expected text');
+    lib.finishMany(read.segments.map((segment) => ({ taskId: segment.taskId, segmentId: segment.segmentId, understanding: '' })));
+    lib.addToPlan([a.key, b.key], { source: 'user' });
+    const progress = lib.list().find((book) => book.key === a.key)!.confirmedChars;
+    const item = lib.planView().items[0];
+    const result = lib.removeFromPlan(item.id, { status: 'skipped', stop: true, reason: 'stopped_by_user' });
+    expect(result.entry.status).toBe('skipped');
+    expect(lib.status().current!.key).toBe(b.key);
+    const kept = lib.list().find((book) => book.key === a.key)!;
+    expect(kept.confirmedChars).toBe(progress);
+    expect(kept.complete).toBe(false);
+    expect(lib.planView().completedCount).toBe(0);
+  });
+
+  it('refuses to stop the last book instead of leaving it outside the plan while still reading', () => {
+    const [a] = seedBooks(['甲']);
+    lib.select(a.key);
+    lib.addToPlan([a.key], { source: 'user' });
+    const item = lib.planView().items[0];
+    // Stopping means "end this one and continue with the next". With no next
+    // revision the request is refused: nothing is archived, nothing is lost.
+    expect(() => lib.removeFromPlan(item.id, { status: 'skipped', stop: true })).toThrow('No other planned book');
+    expect(lib.planView().items.map((row) => row.bookKey)).toEqual([a.key]);
+    expect(lib.status().current!.key).toBe(a.key);
+    // Removing it while keeping it open is the honest alternative.
+    lib.removeFromPlan(item.id, { status: 'skipped', keepReading: true, reason: 'stopped_reading_but_kept' });
+    expect(lib.planView().items).toEqual([]);
+    expect(lib.status().current!.key).toBe(a.key);
+    expect(lib.list()).toHaveLength(1);
+  });
+});
+
+describe('plan additions are idempotent and keep their source', () => {
+  it('ignores duplicates and books that are not on the shelf', () => {
+    const [a, b] = seedBooks(['甲', '乙']);
+    lib.addToPlan([a.key, 'nope:1', b.key, a.key], { source: 'user' });
+    const view = lib.planView();
+    expect(view.items.map((row) => row.bookKey)).toEqual([a.key, b.key]);
+    expect(view.items.map((row) => row.source)).toEqual(['user', 'user']);
+  });
+
+  it('archives an entry whose revision disappeared from the shelf on the next open', () => {
+    const [a, b] = seedBooks(['甲', '乙']);
+    lib.addToPlan([a.key, b.key], { source: 'user' });
+    lib.remove(b.key);
+    close(); open();
+    const view = lib.planView();
+    expect(view.items.map((row) => row.bookKey)).toEqual([a.key]);
+    expect(view.archive.find((entry) => entry.bookKey === b.key)).toMatchObject({ status: 'removed', reason: 'book_removed' });
+  });
+
+  it('keeps the legacy `selection.queue` projection in plan order', () => {
+    const [a, b, c] = seedBooks(['甲', '乙', '丙']);
+    lib.select(a.key);
+    lib.addToPlan([a.key, b.key, c.key], { source: 'user' });
+    expect(lib.selection().queue.map((row) => row.bookKey)).toEqual([a.key, b.key, c.key]);
+    expect(lib.selection().queue.map((row) => row.status)).toEqual(['active', 'queued', 'queued']);
+    lib.updatePlanAction({ action: 'place', itemId: lib.planView().items[2].id, place: 'next' });
+    expect(lib.selection().queue.map((row) => row.bookKey)).toEqual([a.key, c.key, b.key]);
+    expect(lib.selection().queue.map((row) => row.status)).toEqual(['active', 'queued', 'queued']);
+  });
+});
+
+describe('series are organisation only', () => {
+  it('keeps group members together when the group moves', () => {
+    const [a, b, c, d] = seedBooks(['甲', '乙', '丙', '丁']);
+    lib.addToPlan([a.key, b.key, c.key, d.key], { source: 'user' });
+    const view = lib.planView();
+    const series = lib.editPlanSeries({ action: 'create', name: '四部曲', itemIds: [view.items[1].id, view.items[2].id] });
+    const group = series.series.find((row) => row.name === '四部曲')!;
+    expect(group.count).toBe(2);
+    const moved = lib.movePlanSeries(group.id, 1);
+    expect(moved.view.items.map((row) => row.bookKey)).toEqual([b.key, c.key, a.key, d.key]);
+    expect(moved.view.items.filter((row) => row.seriesId === group.id).map((row) => row.position)).toEqual([1, 2]);
+    // Renaming and ungrouping never reorder anything.
+    lib.editPlanSeries({ action: 'rename', seriesId: group.id, name: '四本一起' });
+    expect(lib.planView().series[0].name).toBe('四本一起');
+    lib.editPlanSeries({ action: 'delete', seriesId: group.id });
+    expect(lib.planView().series).toEqual([]);
+    expect(lib.planView().items.map((row) => row.bookKey)).toEqual([b.key, c.key, a.key, d.key]);
+  });
+});
