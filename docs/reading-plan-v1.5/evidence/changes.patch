+function upload(batchId: string, bytes: Buffer): void {
+  for (let offset = 0; offset < bytes.length; offset += 8 * KiB) {
+    batches.zipChunk(batchId, offset, bytes.subarray(offset, offset + 8 * KiB).toString('base64'));
+  }
+}
