+  if (lib) { await batches.shutdown(); try { lib.close(); } catch { /* closed */ } }
+  lib = new Library({ dataDir: dir, now });
+  lib.open();
+  batches = new ImportBatches(lib, join(dir, 'transfers'), { now, budget });
