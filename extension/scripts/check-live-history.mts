const call=async(m:string,args:any[]=[])=>{const r=await fetch('http://127.0.0.1:17788/api/webui/providers/world%3Abookfish/panels/status/'+m,{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({args}),signal:AbortSignal.timeout(120000)});if(!r.ok)throw Error(await r.text());return r.json();};
