const equal=(a:any,b:any)=>isDeepStrictEqual(a,b);for(const e of before.episodes)if(!equal(e,after.episodes.find((x:any)=>x.id===e.id)))throw Error('Episode changed');for(const t of before.tasks.filter((x:any)=>x.status==='committed'))if(!equal(t,after.tasks.find((x:any)=>x.id===t.id)))throw Error('Committed task changed');for(const b of before.books){const a=after.books.find((x:any)=>x.book.id===b.book.id&&x.book.revision===b.book.revision);if(!a||a.frontier<b.frontier||!equal(a.book,b.book))throw Error('Book changed');}if(!equal(before.reviews,after.reviews))throw Error('Review changed');
