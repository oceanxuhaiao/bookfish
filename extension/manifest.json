{
  "manifest_version": 3,
  "name": "BookFish Browser Bridge",
  "version": "0.63.0",
  "description": "Lets the BookFish world use your own Edge/Chrome to open resource pages and fetch TXT files.",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "alarms"],
  "host_permissions": ["http://127.0.0.1/*", "<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "BookFish bridge",
    "default_popup": "popup.html"
  }
}
