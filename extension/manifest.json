{
  "manifest_version": 3,
  "name": "BookFish Browser Bridge",
  "version": "0.63.0",
  "description": "Fetch authorized TXT resources through a protected isolated Chrome/Edge profile. Pairing alone does not enable acquisition.",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "BookFish bridge",
    "default_popup": "popup.html"
  },
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}
