{
  "manifest_version": 3,
  "name": "BookFish Browser Bridge",
  "version": "0.65.1",
  "description": "Fetch authorized TXT resources in user-approved standard mode or recommended enhanced protection mode. Pairing alone is not isolation.",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "https://cn.bing.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "BookFish bridge",
    "default_popup": "popup.html"
  },
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}
