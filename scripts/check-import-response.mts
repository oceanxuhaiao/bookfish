import {readFileSync,writeFileSync,openSync,readSync,closeSync,mkdirSync} from 'node:fs';import {resolve,join} from 'node:path';import {performance} from 'node:perf_hooks';import {Library} from '../src/library.ts';import {BookTransfers} from '../src/transfers.ts';
const mode=process.argv[2]??'worker',source=resolve('output/large-file-check/sample.txt'),root=resolve('output/large-file-check/responsiveness-'+mode+'-'+Date.now());const lib=new Library({dataDir:root});lib.open();const tx=new BookTransfers(lib);const metadata={filename:'sample.txt',title:'异步导入性能样本',author:'合成测试'};
let id:string|undefined;if(mode==='worker'){const t=tx.begin({...metadata,size:104857600}),fd=openSync(source,'r'),bytes=Buffer.alloc(t.chunkBytes);try{let offset=0,n;while((n=readSync(fd,bytes,0,bytes.length,null))){tx.chunk(t.id,offset,bytes.subarray(0,n).toString('base64'));offset+=n;}}finally{closeSync(fd);}id=t.id;}
let last=performance.now(),maxGap=0,ticks=0;const timer=setInterval(()=>{const now=performance.now();maxGap=Math.max(maxGap,now-last);last=now;ticks++;lib.status();},25);await new Promise(r=>setTimeout(r,60));const start=performance.now();let result:any;
try{if(mode==='sync')result=lib.importFile(metadata,source);else {tx.start(id);for(let n=0;n<3000;n++){const state=tx.status(id)!;if(state.state==='failed')throw Error(state.error);if(state.state==='done'){result=state.result;break;}await new Promise(r=>setTimeout(r,25));}if(!result)throw Error('Timeout');}await new Promise(r=>setTimeout(r,60));}finally{clearInterval(timer);}
const proof={version:'0.16.0',mode,sourceBytes:104857600,elapsedMs:Math.round(performance.now()-start),maxHeartbeatGapMs:Math.round(maxGap),heartbeatCount:ticks,bookKey:result.book.key,chars:result.book.totalChars,segments:result.book.totalSegments,unread:result.book.confirmedChars===0,maxRssKiB:process.resourceUsage().maxRSS,cache:lib.storageStats(),limits:'Synthetic isolated library, no model; process RSS includes worker thread. Heartbeat measures main event loop, not end-to-end chat.'};await tx.shutdown();lib.close();writeFileSync('output/import-response-'+mode+'-0.16.0.json',JSON.stringify(proof,null,2));console.log(proof);
