import {readFileSync,writeFileSync} from 'node:fs';
const npm=JSON.parse(readFileSync(process.argv[2]??'_verify/r3-npm-ci-tree.json','utf8')),pnpm=JSON.parse(readFileSync('_verify/r3-pnpm-tree.json','utf8'))[0];
function packages(root:any){const found=new Set<string>();const visit=(row:any)=>{for(const kind of ['dependencies','devDependencies','optionalDependencies'])for(const [name,value] of Object.entries(row[kind]??{}) as Array<[string,any]>){if(value.version){found.add(name+'@'+value.version);visit(value);}}};visit(root);return found;}
const a=packages(npm),b=packages(pnpm);const report={npmCount:a.size,pnpmCount:b.size,npmOnly:[...a].filter(x=>!b.has(x)).sort(),pnpmOnly:[...b].filter(x=>!a.has(x)).sort(),sameInstalledNameVersionSet:a.size===b.size&&[...a].every(x=>b.has(x)),note:'pnpm list includes other-platform optional packages, so raw sets can differ without runtime version drift; inspect differences explicitly'};writeFileSync(process.argv[3]??'_verify/r3-lock-parity.json',JSON.stringify(report,null,2));console.log(JSON.stringify(report));
