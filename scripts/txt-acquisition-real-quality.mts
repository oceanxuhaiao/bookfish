/** One real public-domain novel with explicitly labelled damaged/encoded derivatives. */
import {readFileSync,writeFileSync,readdirSync,mkdirSync}from'node:fs';import{join,resolve}from'node:path';import{createHash}from'node:crypto';import assert from'node:assert/strict';
import{Library}from'../src/library.ts';import{prepareFileBestEffort,decodeFileBestEffort}from'../src/stream-import.ts';
const root=resolve(process.argv[2]??'_verify/real-novels'),variants=join(root,'variants'),results:any[]=[];
const hash=(b:Buffer)=>createHash('sha256').update(b).digest('hex');
for(const name of readdirSync(variants).filter(n=>n.endsWith('.txt'))){const file=join(variants,name),original=readFileSync(file),before=hash(original),kind=name.replace('.txt','');const dataDir=join(root,'shelves',kind);mkdirSync(dataDir,{recursive:true});const library=new Library({dataDir});library.open();
try{let strictRejected=false;try{library.importFile({filename:name,title:kind+' strict'},file);}catch{strictRejected=true;}
const baseline=decodeFileBestEffort(file),prepared=prepareFileBestEffort(file);const canonical=readFileSync(prepared.canonicalFile!,'utf8');assert.equal(canonical,baseline.text,'streaming canonical must equal existing loose decoding');
const imported=library.importFileBestEffort({filename:name,title:'紅樓夢 '+kind,author:'曹雪芹'},file,{decoded:prepared});const first=library.reader({bookKey:imported.book.key,segment:0});const points=[0,Math.floor(first.totalSegments/2),first.totalSegments-1];const probes=points.map(segment=>{const page=library.reader({bookKey:imported.book.key,segment});return{segment,chapter:page.chapter,text:page.segments.map(s=>s.text).join('').slice(0,500)};});
const proseSegments:Array<{segment:number;chapter:string|undefined;text:string}>=[];let cursor:number|null=0;
while(cursor!==null){const page=library.reader({bookKey:imported.book.key,segment:cursor});for(const item of page.segments){if((item.text.match(/[\u3400-\u9fff]/gu)?.length??0)>20)proseSegments.push({segment:item.id,chapter:page.chapter,text:item.text.slice(0,500)});}cursor=page.next;}
const proseProbes=proseSegments.length?[proseSegments[0],proseSegments[Math.floor(proseSegments.length/2)],proseSegments.at(-1)]:[];assert.equal(proseProbes.length,3);
const kept=library.list().find(b=>b.key===imported.book.key)!;assert.equal(kept.confirmedChars??0,0);assert.equal(hash(readFileSync(file)),before);assert.ok(probes.every(p=>p.text.length>0));
const result={id:kind,provenance:kind==='utf8-original'?'real public-domain original':'derived from the same real novel; not another original',bytes:original.length,sha256:before,strictRejected,encoding:prepared.encoding,replacements:prepared.replacements,quality:imported.quality.quality,warnings:imported.quality.warnings.map(w=>w.code),repairs:prepared.repairs.map(w=>w.code),readableChars:imported.quality.readableChars,totalSegments:first.totalSegments,confirmedChars:kept.confirmedChars??0,originalUnchanged:true,streamedTextEqualsLegacy:true,probes,proseProbes,notes:kind.startsWith('mixed-')?'Only the confidently detected global encoding is used. Opposite-encoding portions can remain damaged; no claim of automatic full mixed-encoding restoration.':undefined};results.push(result);console.log(JSON.stringify({...result,probes:undefined,proseProbes:undefined}));
}finally{library.close();}}
writeFileSync(join(root,'quality-results.json'),JSON.stringify({source:JSON.parse(readFileSync(join(variants,'provenance.json'),'utf8')),results},null,2));
