const fd=openSync(fixture,'w');try{let remaining=size;while(remaining){const n=Math.min(256*1024,remaining),bytes=randomBytes(n);for(let i=0;i<n;i++)bytes[i]=i%1000===999?10:65+bytes[i]%26;writeSync(fd,bytes);remaining-=n;}}finally{closeSync(fd);}
