/** Positive real Chrome HTTP/3 followed by WFP negative; not a generic UDP substitute. */
import {spawn,execFileSync}from'node:child_process';import{createServer}from'node:http';import{join,resolve}from'node:path';import{mkdirSync,writeFileSync}from'node:fs';import assert from'node:assert/strict';import{LabBrowser,until}from'./lab-browser.mts';
const root=resolve('_verify/wfp'),id=Date.now(),work=join(root,'h3-'+id);mkdirSync(work,{recursive:true});const exe=join(root,'browser/chrome.exe'),helper=join(root,'WfpLabDual.exe'),manifest=join(root,`h3-filters-${id}.txt`);const records:any[]=[];const record=(v:any)=>{records.push(v);console.log(JSON.stringify(v));};
const python=spawn('python',['scripts/txt-egress-lab/h3-canary.py',work],{windowsHide:true,stdio:['ignore','pipe','pipe']});let pending='',ready:any,requests=0;python.stdout.on('data',chunk=>{pending+=chunk;let end;while((end=pending.indexOf('\n'))>=0){const row=pending.slice(0,end);pending=pending.slice(end+1);try{const event=JSON.parse(row);if(event.kind==='ready')ready=event;else if(event.kind==='actual-h3-request')requests++;}catch{}}});let pyError='';python.stderr.on('data',s=>pyError+=s);
const server=createServer((_q,r)=>r.end('allowed'));await new Promise<void>(ok=>server.listen(0,'127.0.0.1',ok));const allowed=(server.address()as{port:number}).port;let installed=false,browser:LabBrowser|undefined;
async function launch(label:string){browser=new LabBrowser(exe,['--headless','--no-first-run','--disable-background-networking','--disable-component-update','--disable-sync','--disable-extensions','--remote-debugging-pipe','--enable-quic',`--origin-to-force-quic-on=127.0.0.1:${ready.port}`,`--ignore-certificate-errors-spki-list=${ready.spki}`,`--user-data-dir=${join(work,label)}`,'about:blank']);await browser.send('Browser.getVersion');}
try{await until(()=>!!ready,'HTTP3 canary startup '+pyError,10000);record({kind:'local-cert-scope',spkiOnly:true,rootCertificateInstalled:false,port:ready.port});await launch('positive');const page=await browser!.page(`https://127.0.0.1:${ready.port}/`);await until(()=>requests>0,'Chrome real HTTP3 request',12000);const content=await browser!.evaluate(page,'document.body.innerText');assert.ok(content.includes('BOOKFISH_REAL_HTTP3_OK'));record({kind:'actual-Chrome-HTTP3-positive',passed:true,requests,content});await browser!.close();browser=undefined;
execFileSync(helper,['install',manifest,String(allowed),exe],{windowsHide:true});installed=true;const before=requests;await launch('blocked');const blocked=await browser!.page(`https://127.0.0.1:${ready.port}/`);await new Promise(ok=>setTimeout(ok,4000));assert.equal(requests,before);const body=await browser!.evaluate(blocked,'document.body.innerText');assert.ok(!body.includes('BOOKFISH_REAL_HTTP3_OK'));record({kind:'actual-Chrome-HTTP3-WFP-negative',passed:true,requestDelta:requests-before});
}catch(error){record({kind:'failure',error:String(error),pyError});process.exitCode=1;}
finally{await browser?.close();python.kill();await new Promise<void>(ok=>server.close(()=>ok()));if(installed){execFileSync(helper,['remove',manifest],{windowsHide:true});try{execFileSync(helper,['verify',manifest],{windowsHide:true});process.exitCode=1;}catch(error){record({kind:'cleanup',stdout:(error as any).stdout?.toString()});}}writeFileSync(join(root,'results',`h3-${id}.json`),JSON.stringify(records,null,2));}
